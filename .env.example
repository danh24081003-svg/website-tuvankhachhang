# ==========================================
# OSHIN THỜI ĐẠI - ENVIRONMENT CONFIGURATION
# ==========================================

# Application Environment (development | production)
APP_ENV=development
ENVIRONMENT=development

# Server Binding
HOST=127.0.0.1
PORT=8080
APP_URL=http://127.0.0.1:8080

# Secret Key (Generate a secure random string in production: openssl rand -hex 32)
SECRET_KEY=change-this-secret-key-in-production-to-a-secure-random-value

# CORS Allowed Origins (comma-separated list of allowed domains)
ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080

# Database Configuration
# Local SQLite: sqlite:///customer_ai.db
# Production PostgreSQL: postgresql+psycopg2://user:password@host:5432/dbname
DATABASE_URL=sqlite:///customer_ai.db

# ------------------------------------------
# Google Cloud Vertex AI / Gemini AI Settings
# ------------------------------------------
# If using Vertex AI (Recommended for Enterprise/GCP):
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
VERTEX_MODEL=gemini-2.5-flash

# If using Direct Gemini Developer API Key (Alternative):
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-1.5-flash
GEMINI_TIMEOUT_MS=30000

# ------------------------------------------
# Security & Rate Limits
# ------------------------------------------
ADMIN_SESSION_MINUTES=480
ADMIN_LOGIN_RATE_LIMIT_PER_MINUTE=6
CHAT_RATE_LIMIT_PER_MINUTE=20

# ------------------------------------------
# Storage Configuration
# ------------------------------------------
UPLOAD_STORAGE=local
UPLOAD_DIR=static/uploads
UPLOAD_URL_PREFIX=/static/uploads
UPLOAD_MAX_BYTES=5242880
GCS_BUCKET_NAME=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback
